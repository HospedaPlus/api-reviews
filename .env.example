# Optional: docker compose works without this file using these same defaults.
# Copy it to .env to change them. Never commit the real .env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reviews
POSTGRES_PORT=5433
API_PORT=8000
LOG_LEVEL=INFO

# Seed parameters (python -m src.seed --help for every option)
SEED_MODE=dev
SEED_VALUE=42
SEED_DUPLICATE_RATE=0.05

# Only to run the app OUTSIDE Docker (uv run fastapi dev src/main.py)
# against the Postgres container published on port 5433
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/reviews
